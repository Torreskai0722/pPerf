/* $1: launched command PID namespace inode; $2: eligible CPU bitmask.
 * Kernel PIDs and builtin pid/tid are host IDs; cpid is a namespace ID.
 * mapping rows: prev_tid=host PID, next_tid=host TID, target_tid=namespace
 * PID, parent_tid=namespace TID, child_tid=namespace inode. Other rows retain
 * the scheduler CSV schema. Keep all switches, including external occupants.
 */
tracepoint:sched:sched_process_exec
{
  $task = (struct task_struct *)curtask;
  $p = $task->thread_pid;
  $stride = sizeof(struct upid);
  $base = sizeof(struct pid);
  $offset = $base - $stride + ($p->level * $stride);
  $ns = (struct upid *)((uint64)$p + $offset);
  if ($ns->ns->ns.inum == $1 &&
      $ns->nr == (int32)cpid) {
    @tracked[tid] = 1;
  }
  if (@tracked[tid]) {
    printf("%llu,exec,%d,0,0,0,%d,0,0,0,0,%s\n", nsecs, cpu, tid, comm);
  }
}

tracepoint:sched:sched_process_fork
/@tracked[tid]/
{
  @tracked[args->child_pid] = 1;
  printf("%llu,fork,%d,0,0,0,0,%d,%d,0,0,%s\n",
         nsecs, cpu, tid, args->child_pid, args->child_comm);
}

tracepoint:sched:sched_switch
{
  if (@tracked[tid] && !@mapped[tid]) {
    $task = (struct task_struct *)curtask;
    $p = $task->thread_pid;
  $stride = sizeof(struct upid);
  $base = sizeof(struct pid);
  $offset = $base - $stride + ($p->level * $stride);
  $ns = (struct upid *)((uint64)$p + $offset);
    $g = $task->group_leader->thread_pid;
    $stride = sizeof(struct upid);
  $base = sizeof(struct pid);
  $offset = $base - $stride + ($g->level * $stride);
  $gns = (struct upid *)((uint64)$g + $offset);
    printf("%llu,mapping,%d,%d,0,%d,%d,%d,%u,0,0,%s\n",
           nsecs, cpu, pid, tid, $gns->nr,
           $ns->nr, $ns->ns->ns.inum, comm);
    @mapped[tid] = 1;
  }
  if ((cpu < 64 && ((1 << cpu) & $2)) ||
      @tracked[args->prev_pid] || @tracked[args->next_pid]) {
    printf("%llu,switch,%d,%d,%lld,%d,0,0,0,0,0,%s\n",
           nsecs, cpu, args->prev_pid, args->prev_state, args->next_pid, args->prev_comm);
  }
}

tracepoint:sched:sched_wakeup,tracepoint:sched:sched_wakeup_new
/@tracked[args->pid]/
{
  printf("%llu,wakeup,%d,0,0,0,%d,0,0,0,%d,%s\n",
         nsecs, cpu, args->pid, args->target_cpu, args->comm);
}

tracepoint:sched:sched_migrate_task
/@tracked[args->pid]/
{
  printf("%llu,migrate,%d,0,0,0,%d,0,0,%d,%d,%s\n",
         nsecs, cpu, args->pid, args->orig_cpu, args->dest_cpu, args->comm);
}

tracepoint:sched:sched_process_exit
/@tracked[tid]/
{
  printf("%llu,exit,%d,0,0,0,%d,0,0,0,0,%s\n", nsecs, cpu, tid, comm);
  delete(@tracked[tid]);
  delete(@mapped[tid]);
}

