{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pperf.dev/schema/closeloop-run-v2.json",
  "title": "Closed-loop recording run configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "library_thread_counts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "openmp": {"type": "integer", "minimum": 1},
        "mkl": {"type": "integer", "minimum": 1},
        "openblas": {"type": "integer", "minimum": 1},
        "numexpr": {"type": "integer", "minimum": 1},
        "opencv": {"type": "integer", "minimum": 1},
        "pytorch_intraop": {"type": "integer", "minimum": 1},
        "pytorch_interop": {"type": "integer", "minimum": 1}
      }
    }
  },
  "required": ["schema_version", "run", "ros", "replay", "gpu", "models", "recording"],
  "properties": {
    "schema_version": {"const": 2},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "experiment", "provenance", "timeout_seconds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "experiment": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "phase": {"enum": ["measurement", "diagnostic", "validation"]},
        "parent_run_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "intervention_id": {"type": "string", "minLength": 1}
      }
    },
    "ros": {
      "type": "object", "additionalProperties": false,
      "required": ["distribution", "middleware", "domain_id", "launch_package", "launch_file"],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "middleware": {"type": "string", "minLength": 1},
        "domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
        "launch_package": {"type": "string", "minLength": 1},
        "launch_file": {"type": "string", "minLength": 1}
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_token", "metadata_path", "bag_directory", "rate", "topics", "remappings", "readiness_timeout_seconds", "completion_timeout_seconds"],
      "properties": {
        "scene_token": {"type": "string", "minLength": 1},
        "controlled_bag_manifest": {"type": "string", "minLength": 1},
        "controlled_bag_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scene_tokens": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metadata_path": {"type": "string", "minLength": 1},
        "bag_directory": {"type": "string", "minLength": 1},
        "rate": {"type": "number", "exclusiveMinimum": 0},
        "repeat_count": {"type": "integer", "minimum": 1},
        "playback_mode": {"enum": ["full", "partial"]},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "remappings": {"type": "object", "additionalProperties": {"type": "string"}},
        "readiness_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "player_startup_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "completion_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "communication_profile": {"type": "boolean"},
        "cpu_affinity": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "cpu_thread_count": {"type": "integer", "minimum": 1},
        "library_thread_counts": {
          "$ref": "#/$defs/library_thread_counts"
        }
      }
    },
    "gpu": {
      "type": "object", "additionalProperties": false, "required": ["index", "mps_enabled"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "mps_enabled": {"type": "boolean"},
        "graphics_clock_mhz": {"type": "integer", "minimum": 1},
        "memory_clock_mhz": {"type": "integer", "minimum": 1}
      }
    },
    "input_variation": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "effect", "source_scene_name", "scene_factors", "corruption", "replicate", "tenancy"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "effect": {"enum": ["surrounding_environment", "weather", "interaction", "fixed_input"]},
        "source_scene_name": {"type": "string", "minLength": 1},
        "scene_factors": {
          "type": "object", "additionalProperties": false,
          "required": ["road_type", "traffic", "object_density", "complexity", "lighting"],
          "properties": {
            "road_type": {"type": "string", "minLength": 1},
            "traffic": {"type": "string", "minLength": 1},
            "object_density": {"type": "string", "minLength": 1},
            "complexity": {"type": "string", "minLength": 1},
            "lighting": {"type": "string", "minLength": 1}
          }
        },
        "corruption": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "severity", "seed", "dataset_manifest", "dataset_manifest_sha256"],
          "properties": {
            "type": {"enum": ["clean", "fixed", "rain", "snow", "fog", "strong_sunlight"]},
            "severity": {
              "type": ["integer", "null"], "minimum": 0, "maximum": 5
            },
            "full_duration": {"type": "boolean"},
            "rain_rate_mm_per_hour": {"type": "number", "exclusiveMinimum": 0},
            "seed": {"type": "integer", "minimum": 0},
            "dataset_manifest": {"type": "string", "minLength": 1},
            "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "replicate": {"type": "integer", "minimum": 1},
        "tenancy": {"enum": ["single", "two_model", "three_model"]}
      }
    },
    "synthetic_fma": {
      "type": "object", "additionalProperties": false,
      "required": ["client_id", "blocks", "threads", "iterations", "mps_percentage", "paired_deadline_seconds", "cta"],
      "properties": {
        "client_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "blocks": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1, "maximum": 1024},
        "iterations": {"type": "integer", "minimum": 1},
        "mps_percentage": {"type": "integer", "minimum": 1, "maximum": 100},
        "paired_deadline_seconds": {"type": "number", "minimum": 0},
        "cta": {
          "type": "object", "additionalProperties": false,
          "required": ["tracker_library", "record_capacity"],
          "properties": {
            "tracker_library": {"type": "string", "minLength": 1},
            "record_capacity": {"type": "integer", "minimum": 1, "maximum": 3000000}
          }
        }
      }
    },
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "node_name", "task", "modality", "mmlab_model", "architecture_profile", "input_topic", "qos", "warmup_input", "warmup_count", "launch_offset_seconds", "module_annotation_depth"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "node_name": {"type": "string", "minLength": 1},
          "task": {"enum": ["detection", "semantic_segmentation", "instance_segmentation", "panoptic_segmentation", "drivable_segmentation", "lidar_segmentation"]},
          "modality": {"enum": ["image", "lidar"]},
          "mmlab_model": {"type": "string", "minLength": 1},
          "model_config": {"type": "string", "minLength": 1},
          "model_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checkpoint": {"type": "string", "minLength": 1},
          "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "architecture_profile": {"type": "string", "minLength": 1},
          "input_topic": {"type": "string", "minLength": 1},
          "input_message_type": {"enum": ["image", "compressed_image", "pointcloud2"]},
          "point_feature_count": {"type": "integer", "minimum": 3},
          "qos": {"enum": ["sensor_data", "reliable", "best_effort"]},
          "warmup_input": {"type": "string", "minLength": 1},
          "warmup_count": {"type": "integer", "minimum": 1},
          "inference_resize_scale": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          },
          "launch_offset_seconds": {"type": "number", "minimum": 0},
          "module_annotation_depth": {"type": "integer", "minimum": 0},
          "quiet_period_seconds": {"type": "number", "minimum": 0},
          "input_queue_depth": {"type": "integer", "minimum": 1},
          "green_context": {
            "type": "object", "additionalProperties": false,
            "required": ["sm_count", "partition_index"],
            "properties": {
              "sm_count": {"type": "integer", "minimum": 1},
              "partition_index": {"type": "integer", "minimum": 0}
            }
          },
          "paired_trial": {
            "type": "object", "additionalProperties": false,
            "required": ["direction", "role", "trials", "period_seconds", "target_anchor_seconds", "deadline_offset_seconds", "launch_tolerance_seconds", "k_replays"],
            "properties": {
              "direction": {"type": "string", "minLength": 1},
              "role": {"enum": ["target", "co_runner"]},
              "trials": {"type": "integer", "minimum": 1},
              "period_seconds": {"type": "number", "exclusiveMinimum": 0},
              "target_anchor_seconds": {"type": "number", "minimum": 0},
              "deadline_offset_seconds": {"type": "number", "minimum": 0},
              "launch_tolerance_seconds": {"type": "number", "minimum": 0},
              "timing_diagnostics_only": {"type": "boolean"},
              "k_replays": {"enum": [0, 1, 2, 4, 8]},
              "replay_module": {"type": "string", "minLength": 1}
            }
          },
          "mps_percentage": {"type": "integer", "minimum": 1, "maximum": 100},
          "nvbit_cta_profile": {
            "type": "object", "additionalProperties": false,
            "required": ["tracker_library", "targets"],
            "properties": {
              "mode": {"enum": ["passive", "controlled", "mixed"]},
              "tracker_library": {"type": "string", "minLength": 1},
              "kernel_name": {"type": "string", "minLength": 1},
              "grid": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
              "block": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
              "barrier_participants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "record_capacity": {"type": "integer", "minimum": 1, "maximum": 3000000},
              "targets": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label"],
                  "properties": {
                    "label": {"type": "string", "minLength": 1},
                    "scene_index": {"type": "integer", "minimum": 0},
                    "message_order": {"type": "integer", "minimum": 0},
                    "trial": {"type": "integer", "minimum": 0},
                    "kernel_occurrence": {"type": "integer", "minimum": 0},
                    "sequence_start": {"type": "integer", "minimum": 1},
                    "sequence_end": {"type": "integer", "minimum": 1},
                    "align_launch": {"type": "boolean"}
                  },
                  "oneOf": [
                    {"required": ["scene_index", "message_order"], "not": {"required": ["trial"]}},
                    {"required": ["trial"], "not": {"anyOf": [{"required": ["scene_index"]}, {"required": ["message_order"]}]}}
                  ]
                }
              }
            },
            "allOf": [{
              "if": {"required": ["mode"], "properties": {"mode": {"const": "passive"}}},
              "then": {"not": {"required": ["barrier_participants"]}},
              "else": {"required": ["kernel_name", "grid", "block", "barrier_participants"]}
            }]
          },
          "cpu_affinity": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "cpu_thread_count": {"type": "integer", "minimum": 1},
          "library_thread_counts": {
            "$ref": "#/$defs/library_thread_counts"
          }
        }
      }
    },
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "scopes"],
      "properties": {
        "level": {"enum": ["level1", "level2a", "level2b"]},
        "scopes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "contains": {"const": "model"},
          "items": {"enum": ["model", "input", "preprocessing"]}
        },
        "nsys": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "trace", "sample", "backtrace", "gpu_context_switch"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "trace": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cuda", "nvtx", "cudnn"]}},
            "sample": {"const": "none"}, "backtrace": {"const": "none"},
            "cpu_context_switch": {"type": "boolean"},
            "gpu_context_switch": {"type": "boolean"},
            "gpu_metrics_devices": {"type": "string", "minLength": 1},
            "gpu_metrics_frequency_hz": {"type": "integer", "minimum": 10, "maximum": 200000},
            "gpu_metrics_set": {"type": "string", "minLength": 1}
          }
        },
        "ncu": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "kernel_name", "launch_count", "sections"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "kernel_name": {"type": "string", "minLength": 1},
            "launch_count": {"type": "integer", "minimum": 1},
            "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "preprocessing": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "scheduler_backend": {"enum": ["bpftrace", "none"]},
            "off_cpu_stacks": {"type": "boolean"},
            "thread_lifecycle": {"type": "boolean"},
            "data_preprocessor_methods": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "capsule": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "checkpoint_required": {"const": true},
            "timing_repetitions": {"const": 1},
            "deep_repetitions": {"const": 1},
            "sequence_match_attempts": {"const": 3},
            "priority_counterfactual_enabled": {"type": "boolean"},
            "priority_counterfactual_trials": {"const": 3},
            "priority_min_effect_ns": {"type": "integer", "minimum": 0},
            "required_collectors": {"type": "array", "uniqueItems": true, "items": {"enum": ["cupti_activity", "cuda_launch_capture", "cupti_checkpoint"]}},
            "optional_collectors": {"type": "array", "uniqueItems": true, "items": {"enum": ["cupti_pm", "ncu_mps", "nvbit_cta", "nvdebug_readonly"]}}
          }
        }
      }
    }
  }
}
